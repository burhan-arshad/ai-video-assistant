# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored — never commit your API key.

# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — Whisper model size: tiny | base | small | medium | large
# Bigger = more accurate but slower and needs more RAM. Default: small
WHISPER_MODEL=small
